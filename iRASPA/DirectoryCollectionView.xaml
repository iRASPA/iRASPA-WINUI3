<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iRASPA_WinUI.DirectoryCollectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iRASPA_WinUI">

    <UserControl.Resources>
        <!-- Cocoa ProjectCollectionViewItem.xib (160x140 layout slot containing a 140x140
             ProjectSlideCarrierView with a top title label, centered 80x60 thumbnail at 0.8
             opacity, and an 8px-inset ProjectSlideBorderView with 4px border and 8px radius). -->
        <DataTemplate x:Key="ProjectSlideItemTemplate">
            <ItemContainer>
                <Grid Width="160" Height="140"
                      Background="Transparent"
                      CanDrag="True"
                      DragStarting="OnTileDragStarting"
                      PointerEntered="OnTilePointerEntered"
                      PointerExited="OnTilePointerExited">
                    <Grid Width="140" Height="140"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image Source="{Binding SlideCarrierImage}"
                               Width="140" Height="140"
                               Stretch="Fill"
                               IsHitTestVisible="False"/>
                        <Border Margin="8"
                                BorderThickness="4"
                                CornerRadius="8"
                                BorderBrush="{Binding HighlightBorderBrush}"
                                Background="Transparent"
                                IsHitTestVisible="False"/>
                        <Image Source="{Binding ThumbnailImage}"
                               Width="80" Height="60"
                               Margin="30,40,30,40"
                               Opacity="0.8"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Title}"
                                   Margin="17,8,17,100"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="11"
                                   IsTextScaleFactorEnabled="False"
                                   Foreground="#FF000000"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <ItemsView x:Name="GridList"
                   Grid.Row="0"
                   Padding="20"
                   SelectionMode="Single"
                   IsTabStop="True"
                   ItemTemplate="{StaticResource ProjectSlideItemTemplate}"
                   SelectionChanged="OnGridSelectionChanged">
            <ItemsView.Layout>
                <UniformGridLayout MinItemWidth="160"
                                   MinItemHeight="140"
                                   MinColumnSpacing="10"
                                   MinRowSpacing="20"
                                   ItemsStretch="None"/>
            </ItemsView.Layout>
        </ItemsView>

        <!-- Cocoa DirectoryCollectionViewController bottom toolbar with item count label. -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="ItemCountLabel"
                       Text="0 items"
                       FontSize="12"
                       IsTextScaleFactorEnabled="False"
                       Opacity="0.8"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="8,0,12,0"/>
        </Border>
    </Grid>
</UserControl>
