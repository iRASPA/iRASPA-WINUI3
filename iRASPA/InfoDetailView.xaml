<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iRASPA_WinUI.InfoDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iRASPA_WinUI">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Background" Value="#3C808080"/>
        </Style>
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <!-- Cocoa's four outline groups. The storyboard's disclosure triangles
             become Expanders: markup cannot fill a TreeView's RootNodes, which is
             what kept these forms in C++ in the first place. -->
        <Style x:Key="InfoSection" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <!-- A plain string header, so each section carries its own name for
                 screen readers, drawn in the group weight the panes use. -->
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Shown instead of the form when nothing is open, as the other panes do. -->
        <TextBlock x:Name="Hint" Text="Open a structure to edit info."
                   Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel x:Name="Sections">
            <!-- Cocoa CreatorCell: author names, ORCID / Researcher IDs and the
                 affiliation block with a localized country popup. -->
            <Expander Style="{StaticResource InfoSection}" Header="Creator" IsExpanded="True">
                <StackPanel>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Author" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,*,*">
                            <TextBox x:Name="AuthorFirstBox" PlaceholderText="First"
                                     Margin="0,0,4,0" LostFocus="OnTextCommit"/>
                            <TextBox x:Name="AuthorMiddleBox" Grid.Column="1" PlaceholderText="Middle"
                                     Margin="0,0,4,0" LostFocus="OnTextCommit"/>
                            <TextBox x:Name="AuthorLastBox" Grid.Column="2" PlaceholderText="Last"
                                     LostFocus="OnTextCommit"/>
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="ORCHID ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OrcidBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Researcher ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ResearcherBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>

                    <Border Style="{StaticResource Rule}"/>
                    <TextBlock Text="Affiliation" Style="{StaticResource SubHeader}"/>

                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="University" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UniversityBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Faculty" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="FacultyBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Institute" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InstituteBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CityBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <!-- Items come from the OS geo list at load time (Cocoa uses
                         Locale.isoRegionCodes), so they are not spelled out here. -->
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Country" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CountryCombo" Grid.Column="1"
                                  HorizontalAlignment="Stretch" SelectionChanged="OnCountryCommit"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Cocoa CreationCell + CreationMethods: date, temperature and
                 pressure with unit popups, and a method popup that swaps the
                 sub-form below (the storyboard's creationTabView). -->
            <Expander Style="{StaticResource InfoSection}" Header="Creation">
                <StackPanel>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                        <CalendarDatePicker x:Name="CreationDatePicker" Grid.Column="1"
                                            HorizontalAlignment="Stretch" DateChanged="OnDateCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,110">
                            <TextBox x:Name="TemperatureBox" Margin="0,0,4,0" LostFocus="OnTextCommit"/>
                            <ComboBox x:Name="TemperatureScaleCombo" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnEnumCommit">
                                <x:String>Kelvin</x:String>
                                <x:String>Celsius</x:String>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Pressure" Style="{StaticResource FieldLabel}"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,110">
                            <TextBox x:Name="PressureBox" Margin="0,0,4,0" LostFocus="OnTextCommit"/>
                            <ComboBox x:Name="PressureScaleCombo" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnEnumCommit">
                                <x:String>Pascal</x:String>
                                <x:String>Bar</x:String>
                            </ComboBox>
                        </Grid>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                        <TextBlock Text="Method" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="MethodCombo" Grid.Column="1"
                                  HorizontalAlignment="Stretch" SelectionChanged="OnEnumCommit">
                            <x:String>Unknown</x:String>
                            <x:String>Simulation</x:String>
                            <x:String>Experimental</x:String>
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource Rule}"/>

                    <!-- Simulation sub-form (Cocoa tab 0). -->
                    <StackPanel x:Name="SimulationPanel">
                        <TextBlock Text="Unit Cell" Style="{StaticResource SubHeader}"/>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Relax Unit Cell" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="RelaxCombo" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnEnumCommit">
                                <x:String>Unknown</x:String>
                                <x:String>Cell and Edge-Lengths Free</x:String>
                                <x:String>Fixed Angles; Isotropic Edge-Length Free</x:String>
                                <x:String>Fixed Angles; Anisotropic Edge-Length Free</x:String>
                                <x:String>Fixed α-, β- and γ-Angles; Edge-Lengths Free</x:String>
                                <x:String>Fixed Volume; Shape Free</x:String>
                                <x:String>Fixed Cell</x:String>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Atomic Positions" Style="{StaticResource SubHeader}"/>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Software Package" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PositionsSoftwareBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Algorithm" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PositionsAlgorithmCombo" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnEnumCommit">
                                <x:String>Unknown</x:String>
                                <x:String>None</x:String>
                                <x:String>Simplex</x:String>
                                <x:String>Simulated Annealing</x:String>
                                <x:String>Genetic Algorithm</x:String>
                                <x:String>Steepest Descent</x:String>
                                <x:String>Conjugate Gradient</x:String>
                                <x:String>Quasi-Newton</x:String>
                                <x:String>Newton-Raphson</x:String>
                                <x:String>Baker's Algorithm</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Eigenvalues" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="EigenvaluesCombo" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="OnEnumCommit">
                                <x:String>Unknown</x:String>
                                <x:String>None</x:String>
                                <x:String>All positive</x:String>
                                <x:String>Some Small Negative Values</x:String>
                                <x:String>Some Significantly Negative Values</x:String>
                                <x:String>Many Negative Eigenvalues</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Force Field" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PositionsForceFieldBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Force Field Details" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PositionsForceFieldDetailsBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>

                        <TextBlock Text="Atomic Charges" Style="{StaticResource SubHeader}"/>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Software Package" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ChargesSoftwareBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Algorithm" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ChargesAlgorithmBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Force Field" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ChargesForceFieldBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="110,*">
                            <TextBlock Text="Force Field Details" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ChargesForceFieldDetailsBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                    </StackPanel>

                    <!-- Experimental sub-form (Cocoa tab 1). Wider labels, as in
                         the storyboard. -->
                    <StackPanel x:Name="ExperimentalPanel" Visibility="Collapsed">
                        <TextBlock Text="Measurement" Style="{StaticResource SubHeader}"/>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Radiation Type" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RadiationBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Radiation Wavelength" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="WaveLengthBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Measurement Theta" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                <TextBox x:Name="ThetaMinBox" PlaceholderText="Min" Margin="0,0,4,0"
                                         LostFocus="OnTextCommit"/>
                                <TextBox x:Name="ThetaMaxBox" Grid.Column="1" PlaceholderText="Max"
                                         LostFocus="OnTextCommit"/>
                            </Grid>
                        </Grid>

                        <TextBlock Text="Limits" Style="{StaticResource SubHeader}"/>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="h" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                <TextBox x:Name="HminBox" PlaceholderText="Min" Margin="0,0,4,0"
                                         LostFocus="OnTextCommit"/>
                                <TextBox x:Name="HmaxBox" Grid.Column="1" PlaceholderText="Max"
                                         LostFocus="OnTextCommit"/>
                            </Grid>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="k" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                <TextBox x:Name="KminBox" PlaceholderText="Min" Margin="0,0,4,0"
                                         LostFocus="OnTextCommit"/>
                                <TextBox x:Name="KmaxBox" Grid.Column="1" PlaceholderText="Max"
                                         LostFocus="OnTextCommit"/>
                            </Grid>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="l" Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                <TextBox x:Name="LminBox" PlaceholderText="Min" Margin="0,0,4,0"
                                         LostFocus="OnTextCommit"/>
                                <TextBox x:Name="LmaxBox" Grid.Column="1" PlaceholderText="Max"
                                         LostFocus="OnTextCommit"/>
                            </Grid>
                        </Grid>

                        <TextBlock Text="Refinement" Style="{StaticResource SubHeader}"/>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Number of Reflections" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ReflectionsBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Software" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RefinementSoftwareBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Details" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RefinementDetailsBox" Grid.Column="1" Height="64"
                                     AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Goodness-of-fit on F²" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="GoodnessOfFitBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="Final R indices [I&gt;2σ(I)]" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RFactorGtBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="175,*">
                            <TextBlock Text="R Indices (All Data)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RFactorAllBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Cocoa ChemicalCell. -->
            <Expander Style="{StaticResource InfoSection}" Header="Chemical Information">
                <StackPanel>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="190,*">
                        <TextBlock Text="Chemical Formula Moiety" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MoietyBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="190,*">
                        <TextBlock Text="Chemical Formula Sum" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="FormulaSumBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="190,*">
                        <TextBlock Text="Chemical Name Systematic" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SystematicNameBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Cocoa PublicationCell. -->
            <Expander Style="{StaticResource InfoSection}" Header="Citation">
                <StackPanel>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Article Title" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ArticleTitleBox" Grid.Column="1" Height="56"
                                 AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Article Authors" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ArticleAuthorsBox" Grid.Column="1" Height="56"
                                 AcceptsReturn="True" TextWrapping="Wrap" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Journal Title" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="JournalTitleBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Volume" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="VolumeBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NumberBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                        <CalendarDatePicker x:Name="PublicationDatePicker" Grid.Column="1"
                                            HorizontalAlignment="Stretch" DateChanged="OnDateCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="DOI" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DoiBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}" ColumnDefinitions="120,*">
                        <TextBlock Text="Database Codes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DatabaseCodesBox" Grid.Column="1" LostFocus="OnTextCommit"/>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </StackPanel>
</UserControl>
