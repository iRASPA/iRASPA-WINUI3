<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iRASPA_WinUI.BondsDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iRASPA_WinUI">

    <!-- The Bonds tab (Cocoa StructureBondDetailViewController): the asymmetric
         bonds of the selected frame as one virtualized list, over a pinned
         footer carrying the bond count and Recompute Bonds.

         As in the Atoms tab the ItemsView owns the scrolling, so that the rows
         virtualize; an outer ScrollViewer would give the list infinite height
         and defeat that. -->
    <UserControl.Resources>
        <!-- One row of Cocoa's StructureBondDetail table: vis | id | atom ids.
             (the two fixed x/y/z segment clusters) | type | el(A) | el(B) |
             length | length slider. The widths have to stay in sync with the
             header below.

             Bindings resolve through BondFlatItem's ICustomPropertyProvider. -->
        <DataTemplate x:Key="BondRowTemplate">
            <ItemContainer>
                <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent">
                    <!-- A table keeps its own text size: the columns are pinned to
                         the header's and growing them with the system text setting
                         would push the right-hand ones out of the pane. -->
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
                        </Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                            <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
                        </Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                            <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                            <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
                        </Style>
                    </StackPanel.Resources>
                    <!-- IsChecked is a nullable bool and null renders as the
                         indeterminate '-' glyph. FallbackValue/TargetNullValue
                         cover a null coming from the source and the style setter
                         covers the first paint, but neither covers a recycled row:
                         the binding's local value is cleared there and the box is
                         left on null until it is handed its next bond, which is
                         what DataContextChanged is for. Click writes the model, so
                         a two-way setter cannot fire mid-recycle and hide the bond
                         the box no longer belongs to. -->
                    <CheckBox IsChecked="{Binding Visible, Mode=OneWay, FallbackValue=True, TargetNullValue=True}"
                              IsThreeState="False"
                              Click="OnVisibilityClick"
                              DataContextChanged="OnVisibilityBoxDataContextChanged"
                              Width="20" MinWidth="0" MinHeight="0" Padding="0"
                              VerticalAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                                <Setter Property="IsChecked" Value="True"/>
                                <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <TextBlock Text="{Binding IdText}" Width="40" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center" TextAlignment="Right"/>
                    <!-- Cocoa NSLabelSegmentedControl, once per bonded atom: three
                         segments toggle isFixed x/y/z, and the middle one carries
                         that atom's id. -->
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding A1FixedX, Mode=TwoWay, FallbackValue=False, TargetNullValue=False}"
                                      ToolTipService.ToolTip="Fix x" Width="15" MinWidth="0"
                                      MinHeight="0" Padding="0" CornerRadius="3,0,0,3" Height="22"/>
                        <ToggleButton IsChecked="{Binding A1FixedY, Mode=TwoWay, FallbackValue=False, TargetNullValue=False}"
                                      ToolTipService.ToolTip="Fix y" Content="{Binding Tag1}"
                                      Width="34" MinWidth="0" MinHeight="0" Padding="0"
                                      FontFamily="Consolas" FontSize="11" CornerRadius="0" Height="22"/>
                        <ToggleButton IsChecked="{Binding A1FixedZ, Mode=TwoWay, FallbackValue=False, TargetNullValue=False}"
                                      ToolTipService.ToolTip="Fix z" Width="15" MinWidth="0"
                                      MinHeight="0" Padding="0" CornerRadius="0,3,3,0" Height="22"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding A2FixedX, Mode=TwoWay, FallbackValue=False, TargetNullValue=False}"
                                      ToolTipService.ToolTip="Fix x" Width="15" MinWidth="0"
                                      MinHeight="0" Padding="0" CornerRadius="3,0,0,3" Height="22"/>
                        <ToggleButton IsChecked="{Binding A2FixedY, Mode=TwoWay, FallbackValue=False, TargetNullValue=False}"
                                      ToolTipService.ToolTip="Fix y" Content="{Binding Tag2}"
                                      Width="34" MinWidth="0" MinHeight="0" Padding="0"
                                      FontFamily="Consolas" FontSize="11" CornerRadius="0" Height="22"/>
                        <ToggleButton IsChecked="{Binding A2FixedZ, Mode=TwoWay, FallbackValue=False, TargetNullValue=False}"
                                      ToolTipService.ToolTip="Fix z" Width="15" MinWidth="0"
                                      MinHeight="0" Padding="0" CornerRadius="0,3,3,0" Height="22"/>
                    </StackPanel>
                    <ComboBox SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" Width="110"
                              MinWidth="0" MinHeight="0" Padding="8,2,0,2" FontSize="12"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Single"/>
                        <ComboBoxItem Content="Double"/>
                        <ComboBoxItem Content="Partial Double"/>
                        <ComboBoxItem Content="Triple"/>
                    </ComboBox>
                    <TextBlock Text="{Binding ElA}" Width="32" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElB}" Width="32" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Length, Mode=TwoWay}" Width="144" FontFamily="Consolas"
                             FontSize="12" MinWidth="0" MinHeight="0" Padding="4,2,4,3"
                             VerticalAlignment="Center"/>
                    <Slider Value="{Binding LengthValue, Mode=TwoWay}" Minimum="0" Maximum="3"
                            StepFrequency="0.01" Width="38" MinWidth="0"
                            VerticalAlignment="Center" IsThumbToolTipEnabled="False"/>
                </StackPanel>
            </ItemContainer>
        </DataTemplate>

        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" Padding="12" RowDefinitions="Auto,*">
            <TextBlock x:Name="Hint" Grid.RowSpan="2"
                       Text="Open a structure with bonds to edit the bond list."
                       Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- Column titles from Cocoa's table header; the widths mirror the
                 row template. -->
            <StackPanel x:Name="Header" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="vis" Width="20" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Text="id" Width="40" TextAlignment="Right"
                           Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Text="atom ids." Width="132" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Text="type" Width="110" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Text="el(A)" Width="32" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Text="el(B)" Width="32" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Text="length" Width="144" Style="{StaticResource ColumnHeaderStyle}"/>
            </StackPanel>

            <ItemsView x:Name="List" Grid.Row="1" SelectionMode="Extended" MinHeight="120"
                       ItemTemplate="{StaticResource BondRowTemplate}"
                       SelectionChanged="OnSelectionChanged" GotFocus="OnFieldGotFocus"/>
        </Grid>

        <Grid x:Name="Footer" Grid.Row="1" ColumnSpacing="6" Padding="12,4,12,12"
              ColumnDefinitions="*,Auto">
            <TextBlock x:Name="CountText" Opacity="0.7" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Recompute Bonds" Click="OnRecomputeClick"/>
        </Grid>
    </Grid>
</UserControl>
