                                    <NumberBox x:Name="VolBackSpecBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                    <DropDownButton x:Name="VolBackSpecWell" Grid.Column="3" Style="{StaticResource ColorWell}">
                                        <Border x:Name="VolBackSpecSwatch" Style="{StaticResource Swatch}"/>
                                    </DropDownButton>
                                </Grid>
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148">
                                    <TextBlock Text="Shininess" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="VolBackShininessSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                                    <NumberBox x:Name="VolBackShininessBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ================= Blocking Pockets ================= -->
            <Expander Style="{StaticResource Section}" Header="Blocking Pockets">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="BlockHint" Style="{StaticResource Hint}"
                               Text="Not available for this structure." Visibility="Collapsed"/>
                    <StackPanel x:Name="BlockBody" Spacing="6">
                        <CheckBox x:Name="BlockDraw" Content="Show Blocking Pockets"/>

                        <Border Style="{StaticResource TitledBox}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Outside Surface" Style="{StaticResource BoxHeader}"/>
                                <CheckBox x:Name="BlockHDR" Content="High Dynamic Range"/>
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148">
                                    <TextBlock Text="Exposure" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BlockHDRExpSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                                    <NumberBox x:Name="BlockHDRExpBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148,56">
                                    <TextBlock Text="Ambient Light Intensity" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BlockAmbSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                                    <NumberBox x:Name="BlockAmbBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                    <DropDownButton x:Name="BlockAmbWell" Grid.Column="3" Style="{StaticResource ColorWell}">
                                        <Border x:Name="BlockAmbSwatch" Style="{StaticResource Swatch}"/>
                                    </DropDownButton>
                                </Grid>
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148,56">
                                    <TextBlock Text="Diffuse Light Intensity" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BlockDiffSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                                    <NumberBox x:Name="BlockDiffBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                    <DropDownButton x:Name="BlockDiffWell" Grid.Column="3" Style="{StaticResource ColorWell}">
                                        <Border x:Name="BlockDiffSwatch" Style="{StaticResource Swatch}"/>
                                    </DropDownButton>
                                </Grid>
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148,56">
                                    <TextBlock Text="Specular Light Intensity" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BlockSpecSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                                    <NumberBox x:Name="BlockSpecBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                    <DropDownButton x:Name="BlockSpecWell" Grid.Column="3" Style="{StaticResource ColorWell}">
                                        <Border x:Name="BlockSpecSwatch" Style="{StaticResource Swatch}"/>
                                    </DropDownButton>
                                </Grid>
                                <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148">
                                    <TextBlock Text="Shininess" Style="{StaticResource RowLabel}"/>
                                    <Slider x:Name="BlockShininessSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                                    <NumberBox x:Name="BlockShininessBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- ================= Annotation ================= -->
            <Expander Style="{StaticResource Section}" Header="Annotation">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AnnotationHint" Style="{StaticResource Hint}"
                               Text="Not available for this structure." Visibility="Collapsed"/>
                    <StackPanel x:Name="AnnotationBody" Spacing="6">
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Type" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AnnType" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Font" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AnnFont" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Alignment" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AnnAlign" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Style" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="AnnStyle" Grid.Column="1" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Color" Style="{StaticResource RowLabel}"/>
                            <DropDownButton x:Name="AnnColorWell" Grid.Column="1" Style="{StaticResource ColorWell}">
                                <Border x:Name="AnnColorSwatch" Style="{StaticResource Swatch}"/>
                            </DropDownButton>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*,148">
                            <TextBlock Text="Scaling" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="AnnScalingSlider" Grid.Column="1" Style="{StaticResource RowSlider}"/>
                            <NumberBox x:Name="AnnScalingBox" Grid.Column="2" Style="{StaticResource SliderNum}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Text Offset X" Style="{StaticResource RowLabel}"/>
                            <NumberBox x:Name="AnnOffsetX" Grid.Column="1" Style="{StaticResource Num}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Y" Style="{StaticResource RowLabel}"/>
                            <NumberBox x:Name="AnnOffsetY" Grid.Column="1" Style="{StaticResource Num}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}" ColumnDefinitions="150,*">
                            <TextBlock Text="Z" Style="{StaticResource RowLabel}"/>
                            <NumberBox x:Name="AnnOffsetZ" Grid.Column="1" Style="{StaticResource Num}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </StackPanel>
</UserControl>
