<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7c3f2b91-5d64-4a0e-9f18-2b6a4c8e5d31}</ProjectGuid>
    <ProjectName>iRASPA.Export</ProjectName>
    <RootNamespace>iRASPAExport</RootNamespace>
    <TargetName>iRASPA.Export</TargetName>
    <Keyword>Win32Proj</Keyword>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <!-- A plain Win32 console program, like iRASPAKit.vcxproj and unlike iRASPA.vcxproj:
         no Windows App SDK, no C++/WinRT, no XAML and no Python. Everything it needs is
         the kit library and the system D3D12/WIC/Media Foundation libraries. -->
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' &lt; '18.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(MSBuildThisFileDirectory)..\iraspa-common.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Beside iRASPA.exe: the app starts the helper from its own directory. -->
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\obj\$(Platform)\$(Configuration)\iRASPA.Export\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..;$(IraspaIncludeDirs);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Console, so that the progress protocol on stdout reaches the parent. -->
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>d3d12.lib;dxgi.lib;d3dcompiler.lib;dwrite.lib;user32.lib;windowscodecs.lib;mfplat.lib;mfreadwrite.lib;mfuuid.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Same as the app: SKSpaceGroupDataBase::spaceGroupData is a CRT initializer that
           needs more stack than the 1 MB default. -->
      <StackReserveSize>4194304</StackReserveSize>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <Link>
      <!-- liblzma and zlib back the .irspdoc container (foundationkit\zip.cpp). -->
      <!-- zs.lib is zlib; the vcpkg port renamed it from zlib.lib in 1.3.2. -->
      <AdditionalDependencies>lzma.lib;zsd.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(VcpkgStaticRoot)\debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <Link>
      <AdditionalDependencies>lzma.lib;zs.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(VcpkgStaticRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="ExportJob.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="ExportJob.cpp" />
    <!-- Shared with the app so that both processes derive the staging file name, and the
         job format, from one definition. -->
    <ClCompile Include="..\ExportJobWriter.cpp" />
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\iraspa\iRASPAKit.vcxproj">
      <Project>{21b2e413-524a-4efe-8031-cffb57611345}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- This is the process that actually traces an exported picture, so the redistributable runtime
       matters more here than anywhere: on a machine without DXR 1.1 it is the only thing that can
       trace at all. See external\d3d12\README.md. -->
  <Target Name="DeployDirect3DRuntime" AfterTargets="Build">
    <PropertyGroup>
      <_Direct3DRuntimeDir>$(MSBuildThisFileDirectory)..\..\external\d3d12\$(PlatformTarget)</_Direct3DRuntimeDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- The runtime in the subfolder directxagilitysdk.h names, the adapter beside the exe. See
           the same target in iRASPA.vcxproj for why the two cannot be put in one place. -->
      <_Direct3DRuntimeFiles Include="$(_Direct3DRuntimeDir)\D3D12Core.dll" Condition="Exists('$(_Direct3DRuntimeDir)\D3D12Core.dll')" />
      <_Direct3DRuntimeFiles Include="$(_Direct3DRuntimeDir)\d3d12SDKLayers.dll" Condition="'$(Configuration)' == 'Debug' and Exists('$(_Direct3DRuntimeDir)\d3d12SDKLayers.dll')" />
      <_Direct3DAdapterFiles Include="$(_Direct3DRuntimeDir)\d3d10warp.dll" Condition="Exists('$(_Direct3DRuntimeDir)\d3d10warp.dll')" />
    </ItemGroup>
    <Warning Condition="'@(_Direct3DRuntimeFiles)' == '' or '@(_Direct3DAdapterFiles)' == ''"
             Text="Incomplete redistributable D3D12 runtime in $(_Direct3DRuntimeDir); on a machine without DXR 1.1 a traced export will fall back to rasterizing." />
    <Copy SourceFiles="@(_Direct3DRuntimeFiles)" DestinationFolder="$(OutDir)D3D12" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_Direct3DAdapterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
