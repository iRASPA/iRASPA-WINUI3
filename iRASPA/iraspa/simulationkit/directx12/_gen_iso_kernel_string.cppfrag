cbuffer IsoConstants : register(b0)
{
  int4 dimensions;
  float isolevel;
  int sumTriangles;
  int pad0;
  int pad1;
};

Texture3D<float> rawData : register(t0);
RWTexture3D<uint4> hpBaseUav : register(u0);

Texture3D<uint4> constructReadBase : register(t3);
Texture3D<uint> constructReadLevel : register(t4);
RWTexture3D<uint> constructWrite : register(u3);

Texture3D<uint4> travHp0 : register(t10);
Texture3D<uint> travHp1 : register(t11);
Texture3D<uint> travHp2 : register(t12);
Texture3D<uint> travHp3 : register(t13);
Texture3D<uint> travHp4 : register(t14);
Texture3D<uint> travHp5 : register(t15);
Texture3D<uint> travHp6 : register(t16);
Texture3D<uint> travHp7 : register(t17);
Texture3D<uint> travHp8 : register(t18);
RWStructuredBuffer<float4> VBOBuffer : register(u2);

int3 wrapDim(int3 p)
{
  int3 d = dimensions.xyz;
  p.x = ((p.x % d.x) + d.x) % d.x;
  p.y = ((p.y % d.y) + d.y) % d.y;
  p.z = ((p.z % d.z) + d.z) % d.z;
  return p;
}

float sampleRaw(int3 p)
{
  return rawData.Load(int4(wrapDim(p), 0));
}

[numthreads(8,8,8)]
void classifyCubes(uint3 id : SV_DispatchThreadID)
{
  int3 pos = int3(id);
  if (any(pos >= dimensions.xyz))
  {
    hpBaseUav[pos] = uint4(0,0,0,0);
    return;
  }
  float first = sampleRaw(pos);
  uint cubeindex =
      ((first > isolevel) ? 1u : 0u) |
      ((sampleRaw(pos + cubeOffsets[1]) > isolevel) ? 2u : 0u) |
      ((sampleRaw(pos + cubeOffsets[3]) > isolevel) ? 4u : 0u) |
      ((sampleRaw(pos + cubeOffsets[2]) > isolevel) ? 8u : 0u) |
      ((sampleRaw(pos + cubeOffsets[4]) > isolevel) ? 16u : 0u) |
      ((sampleRaw(pos + cubeOffsets[5]) > isolevel) ? 32u : 0u) |
      ((sampleRaw(pos + cubeOffsets[7]) > isolevel) ? 64u : 0u) |
      ((sampleRaw(pos + cubeOffsets[6]) > isolevel) ? 128u : 0u);
  hpBaseUav[pos] = uint4(numberOfTriangles[cubeindex], cubeindex, asuint(first), 0);
}

[numthreads(8,8,8)]
void constructHPLevelFromBase(uint3 id : SV_DispatchThreadID)
{
  int3 writePos = int3(id);
  int3 readPos = writePos * 2;
  uint sumv = 0;
  [unroll] for (int i = 0; i < 8; ++i)
    sumv += constructReadBase.Load(int4(readPos + cubeOffsets[i], 0)).x;
  constructWrite[writePos] = sumv;
}

[numthreads(8,8,8)]
void constructHPLevel(uint3 id : SV_DispatchThreadID)
{
  int3 writePos = int3(id);
  int3 readPos = writePos * 2;
  uint sumv = 0;
  [unroll] for (int i = 0; i < 8; ++i)
    sumv += constructReadLevel.Load(int4(readPos + cubeOffsets[i], 0));
  constructWrite[writePos] = sumv;
}

int4 scanHPLevelBase(int target, Texture3D<uint4> hp, int4 current)
{
  int neighbors[8];
  [unroll] for (int i = 0; i < 8; ++i)
    neighbors[i] = (int)hp.Load(int4(current.xyz + cubeOffsets[i], 0)).x;
  int acc = current.w + neighbors[0];
  int cmp[8];
  cmp[0] = acc <= target;
  [unroll] for (int i = 1; i < 7; ++i) { acc += neighbors[i]; cmp[i] = acc <= target; }
  cmp[7] = 0;
  int idx = cmp[0]+cmp[1]+cmp[2]+cmp[3]+cmp[4]+cmp[5]+cmp[6]+cmp[7];
  current.xyz += cubeOffsets[idx];
  current.xyz *= 2;
  current.w = current.w
    + cmp[0]*neighbors[0] + cmp[1]*neighbors[1] + cmp[2]*neighbors[2] + cmp[3]*neighbors[3]
    + cmp[4]*neighbors[4] + cmp[5]*neighbors[5] + cmp[6]*neighbors[6] + cmp[7]*neighbors[7];
  return current;
}

int4 scanHPLevelU(int target, Texture3D<uint> hp, int4 current)
{
  int neighbors[8];
  [unroll] for (int i = 0; i < 8; ++i)
    neighbors[i] = (int)hp.Load(int4(current.xyz + cubeOffsets[i], 0));
  int acc = current.w + neighbors[0];
  int cmp[8];
  cmp[0] = acc <= target;
  [unroll] for (int i = 1; i < 7; ++i) { acc += neighbors[i]; cmp[i] = acc <= target; }
  cmp[7] = 0;
  int idx = cmp[0]+cmp[1]+cmp[2]+cmp[3]+cmp[4]+cmp[5]+cmp[6]+cmp[7];
  current.xyz += cubeOffsets[idx];
  current.xyz *= 2;
  current.w = current.w
    + cmp[0]*neighbors[0] + cmp[1]*neighbors[1] + cmp[2]*neighbors[2] + cmp[3]*neighbors[3]
    + cmp[4]*neighbors[4] + cmp[5]*neighbors[5] + cmp[6]*neighbors[6] + cmp[7]*neighbors[7];
  return current;
}

[numthreads(64,1,1)]
void traverseHP16(uint3 dtid : SV_DispatchThreadID)
{
  int target = (int)dtid.x;
  if (target >= sumTriangles)
    target = 0;

  int4 cubePosition = int4(0,0,0,0);
  cubePosition = scanHPLevelU(target, travHp3, cubePosition);
  cubePosition = scanHPLevelU(target, travHp2, cubePosition);
  cubePosition = scanHPLevelU(target, travHp1, cubePosition);
  cubePosition = scanHPLevelBase(target, travHp0, cubePosition);
  cubePosition.xyz /= 2;

  int vertexNr = 0;
  uint4 cubeData = travHp0.Load(int4(cubePosition.xyz, 0));

  for (int i = (target - cubePosition.w) * 3; i < (target - cubePosition.w + 1) * 3; ++i)
  {
    int edge = triTable[cubeData.y * 16 + i];
    int3 point0 = int3(cubePosition.x + offsets3[edge * 6],
                       cubePosition.y + offsets3[edge * 6 + 1],
                       cubePosition.z + offsets3[edge * 6 + 2]);
    int3 point1 = int3(cubePosition.x + offsets3[edge * 6 + 3],
                       cubePosition.y + offsets3[edge * 6 + 4],
                       cubePosition.z + offsets3[edge * 6 + 5]);

    float4 forwardDifference0 = float4(
      -sampleRaw(point0 + int3(1,0,0)) + sampleRaw(point0 + int3(-1,0,0)),
      -sampleRaw(point0 + int3(0,1,0)) + sampleRaw(point0 + int3(0,-1,0)),
      -sampleRaw(point0 + int3(0,0,1)) + sampleRaw(point0 + int3(0,0,-1)),
      0.0f);
    float4 forwardDifference1 = float4(
      -sampleRaw(point1 + int3(1,0,0)) + sampleRaw(point1 + int3(-1,0,0)),
      -sampleRaw(point1 + int3(0,1,0)) + sampleRaw(point1 + int3(0,-1,0)),
      -sampleRaw(point1 + int3(0,0,1)) + sampleRaw(point1 + int3(0,0,-1)),
      0.0f);

    float value0 = sampleRaw(point0);
    float value1 = sampleRaw(point1);
    float diff = (isolevel - value0) / (value1 - value0);

    float4 vertex = float4(point0, 1.0f) + (float4(point1, 0.0f) - float4(point0, 0.0f)) * diff;
    float4 scaledVertex = float4(vertex.x / (float)dimensions.x,
                                 vertex.y / (float)dimensions.y,
                                 vertex.z / (float)dimensions.z, 1.0f);
    float4 normal = forwardDifference0 + (forwardDifference1 - forwardDifference0) * diff;

    VBOBuffer[target * 9 + vertexNr * 3] = scaledVertex;
    VBOBuffer[target * 9 + vertexNr * 3 + 1] = normal;
    VBOBuffer[target * 9 + vertexNr * 3 + 2] = float4(0,0,0,0);
    vertexNr++;
  }
}

[numthreads(64,1,1)]
void traverseHP32(uint3 dtid : SV_DispatchThreadID)
{
  int target = (int)dtid.x;
  if (target >= sumTriangles)
    target = 0;

  int4 cubePosition = int4(0,0,0,0);
  cubePosition = scanHPLevelU(target, travHp4, cubePosition);
  cubePosition = scanHPLevelU(target, travHp3, cubePosition);
  cubePosition = scanHPLevelU(target, travHp2, cubePosition);
  cubePosition = scanHPLevelU(target, travHp1, cubePosition);
  cubePosition = scanHPLevelBase(target, travHp0, cubePosition);
  cubePosition.xyz /= 2;

  int vertexNr = 0;
  uint4 cubeData = travHp0.Load(int4(cubePosition.xyz, 0));

  for (int i = (target - cubePosition.w) * 3; i < (target - cubePosition.w + 1) * 3; ++i)
  {
    int edge = triTable[cubeData.y * 16 + i];
    int3 point0 = int3(cubePosition.x + offsets3[edge * 6],
                       cubePosition.y + offsets3[edge * 6 + 1],
                       cubePosition.z + offsets3[edge * 6 + 2]);
    int3 point1 = int3(cubePosition.x + offsets3[edge * 6 + 3],
                       cubePosition.y + offsets3[edge * 6 + 4],
                       cubePosition.z + offsets3[edge * 6 + 5]);

    float4 forwardDifference0 = float4(
      -sampleRaw(point0 + int3(1,0,0)) + sampleRaw(point0 + int3(-1,0,0)),
      -sampleRaw(point0 + int3(0,1,0)) + sampleRaw(point0 + int3(0,-1,0)),
      -sampleRaw(point0 + int3(0,0,1)) + sampleRaw(point0 + int3(0,0,-1)),
      0.0f);
    float4 forwardDifference1 = float4(
      -sampleRaw(point1 + int3(1,0,0)) + sampleRaw(point1 + int3(-1,0,0)),
      -sampleRaw(point1 + int3(0,1,0)) + sampleRaw(point1 + int3(0,-1,0)),
      -sampleRaw(point1 + int3(0,0,1)) + sampleRaw(point1 + int3(0,0,-1)),
      0.0f);

    float value0 = sampleRaw(point0);
    float value1 = sampleRaw(point1);
    float diff = (isolevel - value0) / (value1 - value0);

    float4 vertex = float4(point0, 1.0f) + (float4(point1, 0.0f) - float4(point0, 0.0f)) * diff;
    float4 scaledVertex = float4(vertex.x / (float)dimensions.x,
                                 vertex.y / (float)dimensions.y,
                                 vertex.z / (float)dimensions.z, 1.0f);
    float4 normal = forwardDifference0 + (forwardDifference1 - forwardDifference0) * diff;

    VBOBuffer[target * 9 + vertexNr * 3] = scaledVertex;
    VBOBuffer[target * 9 + vertexNr * 3 + 1] = normal;
    VBOBuffer[target * 9 + vertexNr * 3 + 2] = float4(0,0,0,0);
    vertexNr++;
  }
}

[numthreads(64,1,1)]
void traverseHP64(uint3 dtid : SV_DispatchThreadID)
{
  int target = (int)dtid.x;
  if (target >= sumTriangles)
    target = 0;

  int4 cubePosition = int4(0,0,0,0);
  cubePosition = scanHPLevelU(target, travHp5, cubePosition);
  cubePosition = scanHPLevelU(target, travHp4, cubePosition);
  cubePosition = scanHPLevelU(target, travHp3, cubePosition);
  cubePosition = scanHPLevelU(target, travHp2, cubePosition);
  cubePosition = scanHPLevelU(target, travHp1, cubePosition);
  cubePosition = scanHPLevelBase(target, travHp0, cubePosition);
  cubePosition.xyz /= 2;

  int vertexNr = 0;
  uint4 cubeData = travHp0.Load(int4(cubePosition.xyz, 0));

  for (int i = (target - cubePosition.w) * 3; i < (target - cubePosition.w + 1) * 3; ++i)
  {
    int edge = triTable[cubeData.y * 16 + i];
    int3 point0 = int3(cubePosition.x + offsets3[edge * 6],
                       cubePosition.y + offsets3[edge * 6 + 1],
                       cubePosition.z + offsets3[edge * 6 + 2]);
    int3 point1 = int3(cubePosition.x + offsets3[edge * 6 + 3],
                       cubePosition.y + offsets3[edge * 6 + 4],
                       cubePosition.z + offsets3[edge * 6 + 5]);

    float4 forwardDifference0 = float4(
      -sampleRaw(point0 + int3(1,0,0)) + sampleRaw(point0 + int3(-1,0,0)),
      -sampleRaw(point0 + int3(0,1,0)) + sampleRaw(point0 + int3(0,-1,0)),
      -sampleRaw(point0 + int3(0,0,1)) + sampleRaw(point0 + int3(0,0,-1)),
      0.0f);
    float4 forwardDifference1 = float4(
      -sampleRaw(point1 + int3(1,0,0)) + sampleRaw(point1 + int3(-1,0,0)),
      -sampleRaw(point1 + int3(0,1,0)) + sampleRaw(point1 + int3(0,-1,0)),
      -sampleRaw(point1 + int3(0,0,1)) + sampleRaw(point1 + int3(0,0,-1)),
      0.0f);

    float value0 = sampleRaw(point0);
    float value1 = sampleRaw(point1);
    float diff = (isolevel - value0) / (value1 - value0);

    float4 vertex = float4(point0, 1.0f) + (float4(point1, 0.0f) - float4(point0, 0.0f)) * diff;
    float4 scaledVertex = float4(vertex.x / (float)dimensions.x,
                                 vertex.y / (float)dimensions.y,
                                 vertex.z / (float)dimensions.z, 1.0f);
    float4 normal = forwardDifference0 + (forwardDifference1 - forwardDifference0) * diff;

    VBOBuffer[target * 9 + vertexNr * 3] = scaledVertex;
    VBOBuffer[target * 9 + vertexNr * 3 + 1] = normal;
    VBOBuffer[target * 9 + vertexNr * 3 + 2] = float4(0,0,0,0);
    vertexNr++;
  }
}

[numthreads(64,1,1)]
void traverseHP128(uint3 dtid : SV_DispatchThreadID)
{
  int target = (int)dtid.x;
  if (target >= sumTriangles)
    target = 0;

  int4 cubePosition = int4(0,0,0,0);
  cubePosition = scanHPLevelU(target, travHp6, cubePosition);
  cubePosition = scanHPLevelU(target, travHp5, cubePosition);
  cubePosition = scanHPLevelU(target, travHp4, cubePosition);
  cubePosition = scanHPLevelU(target, travHp3, cubePosition);
  cubePosition = scanHPLevelU(target, travHp2, cubePosition);
  cubePosition = scanHPLevelU(target, travHp1, cubePosition);
  cubePosition = scanHPLevelBase(target, travHp0, cubePosition);
  cubePosition.xyz /= 2;

  int vertexNr = 0;
  uint4 cubeData = travHp0.Load(int4(cubePosition.xyz, 0));

  for (int i = (target - cubePosition.w) * 3; i < (target - cubePosition.w + 1) * 3; ++i)
  {
    int edge = triTable[cubeData.y * 16 + i];
    int3 point0 = int3(cubePosition.x + offsets3[edge * 6],
                       cubePosition.y + offsets3[edge * 6 + 1],
                       cubePosition.z + offsets3[edge * 6 + 2]);
    int3 point1 = int3(cubePosition.x + offsets3[edge * 6 + 3],
                       cubePosition.y + offsets3[edge * 6 + 4],
                       cubePosition.z + offsets3[edge * 6 + 5]);

    float4 forwardDifference0 = float4(
      -sampleRaw(point0 + int3(1,0,0)) + sampleRaw(point0 + int3(-1,0,0)),
      -sampleRaw(point0 + int3(0,1,0)) + sampleRaw(point0 + int3(0,-1,0)),
      -sampleRaw(point0 + int3(0,0,1)) + sampleRaw(point0 + int3(0,0,-1)),
      0.0f);
    float4 forwardDifference1 = float4(
      -sampleRaw(point1 + int3(1,0,0)) + sampleRaw(point1 + int3(-1,0,0)),
      -sampleRaw(point1 + int3(0,1,0)) + sampleRaw(point1 + int3(0,-1,0)),
      -sampleRaw(point1 + int3(0,0,1)) + sampleRaw(point1 + int3(0,0,-1)),
      0.0f);

    float value0 = sampleRaw(point0);
    float value1 = sampleRaw(point1);
    float diff = (isolevel - value0) / (value1 - value0);

    float4 vertex = float4(point0, 1.0f) + (float4(point1, 0.0f) - float4(point0, 0.0f)) * diff;
    float4 scaledVertex = float4(vertex.x / (float)dimensions.x,
                                 vertex.y / (float)dimensions.y,
                                 vertex.z / (float)dimensions.z, 1.0f);
    float4 normal = forwardDifference0 + (forwardDifference1 - forwardDifference0) * diff;

    VBOBuffer[target * 9 + vertexNr * 3] = scaledVertex;
    VBOBuffer[target * 9 + vertexNr * 3 + 1] = normal;
    VBOBuffer[target * 9 + vertexNr * 3 + 2] = float4(0,0,0,0);
    vertexNr++;
  }
}

[numthreads(64,1,1)]
void traverseHP256(uint3 dtid : SV_DispatchThreadID)
{
  int target = (int)dtid.x;
  if (target >= sumTriangles)
    target = 0;

  int4 cubePosition = int4(0,0,0,0);
  cubePosition = scanHPLevelU(target, travHp7, cubePosition);
  cubePosition = scanHPLevelU(target, travHp6, cubePosition);
  cubePosition = scanHPLevelU(target, travHp5, cubePosition);
  cubePosition = scanHPLevelU(target, travHp4, cubePosition);
  cubePosition = scanHPLevelU(target, travHp3, cubePosition);
  cubePosition = scanHPLevelU(target, travHp2, cubePosition);
  cubePosition = scanHPLevelU(target, travHp1, cubePosition);
  cubePosition = scanHPLevelBase(target, travHp0, cubePosition);
  cubePosition.xyz /= 2;

  int vertexNr = 0;
  uint4 cubeData = travHp0.Load(int4(cubePosition.xyz, 0));

  for (int i = (target - cubePosition.w) * 3; i < (target - cubePosition.w + 1) * 3; ++i)
  {
    int edge = triTable[cubeData.y * 16 + i];
    int3 point0 = int3(cubePosition.x + offsets3[edge * 6],
                       cubePosition.y + offsets3[edge * 6 + 1],
                       cubePosition.z + offsets3[edge * 6 + 2]);
    int3 point1 = int3(cubePosition.x + offsets3[edge * 6 + 3],
                       cubePosition.y + offsets3[edge * 6 + 4],
                       cubePosition.z + offsets3[edge * 6 + 5]);

    float4 forwardDifference0 = float4(
      -sampleRaw(point0 + int3(1,0,0)) + sampleRaw(point0 + int3(-1,0,0)),
      -sampleRaw(point0 + int3(0,1,0)) + sampleRaw(point0 + int3(0,-1,0)),
      -sampleRaw(point0 + int3(0,0,1)) + sampleRaw(point0 + int3(0,0,-1)),
      0.0f);
    float4 forwardDifference1 = float4(
      -sampleRaw(point1 + int3(1,0,0)) + sampleRaw(point1 + int3(-1,0,0)),
      -sampleRaw(point1 + int3(0,1,0)) + sampleRaw(point1 + int3(0,-1,0)),
      -sampleRaw(point1 + int3(0,0,1)) + sampleRaw(point1 + int3(0,0,-1)),
      0.0f);

    float value0 = sampleRaw(point0);
    float value1 = sampleRaw(point1);
    float diff = (isolevel - value0) / (value1 - value0);

    float4 vertex = float4(point0, 1.0f) + (float4(point1, 0.0f) - float4(point0, 0.0f)) * diff;
    float4 scaledVertex = float4(vertex.x / (float)dimensions.x,
                                 vertex.y / (float)dimensions.y,
                                 vertex.z / (float)dimensions.z, 1.0f);
    float4 normal = forwardDifference0 + (forwardDifference1 - forwardDifference0) * diff;

    VBOBuffer[target * 9 + vertexNr * 3] = scaledVertex;
    VBOBuffer[target * 9 + vertexNr * 3 + 1] = normal;
    VBOBuffer[target * 9 + vertexNr * 3 + 2] = float4(0,0,0,0);
    vertexNr++;
  }
}

[numthreads(64,1,1)]
void traverseHP512(uint3 dtid : SV_DispatchThreadID)
{
  int target = (int)dtid.x;
  if (target >= sumTriangles)
    target = 0;

  int4 cubePosition = int4(0,0,0,0);
  cubePosition = scanHPLevelU(target, travHp8, cubePosition);
  cubePosition = scanHPLevelU(target, travHp7, cubePosition);
