<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iRASPA_WinUI.ElementsDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iRASPA_WinUI">

    <!-- The Elements tab (Cocoa StructureElementDetailViewController): one card
         per force-field atom type, over a bottom toolbar carrying the
         force-field-set and color-set combos (Cocoa's BottomToolbarPanel).

         The ItemsView owns the scrolling rather than the inspector's shared
         ScrollViewer, because a set has 117 cards and they have to virtualize. -->
    <UserControl.Resources>
        <!-- Cocoa's elementContextMenu, shown from the right-tap handler so the
             two items can be gated on the row that was clicked. -->
        <MenuFlyout x:Key="RowMenu">
            <MenuFlyoutItem x:Name="InsertTypeItem" Text="Insert new type"
                            Click="OnInsertTypeMenu"/>
            <MenuFlyoutItem x:Name="DeleteTypeItem" Text="Delete type"
                            Click="OnDeleteTypeMenu"/>
        </MenuFlyout>

        <!-- The custom "elementView" NSTableCellView of
             StructureElementDetail.storyboard: a header with the big chemical
             symbol, the color well and the visibility checkbox, then a
             label/field grid, then oxidation states with epsilon and sigma.
             Bindings resolve through ElementCardItem's ICustomPropertyProvider,
             and the editable fields write straight through to the
             ForceFieldType, as the Cocoa cell's target/actions do. -->
        <DataTemplate x:Key="ElementCardTemplate">
            <ItemContainer>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8,10,10"
                        Margin="0,3,0,3" HorizontalAlignment="Stretch">
                    <!-- The labels are what the width is for: they are the long
                         side of every row, so the value boxes are held at a
                         width a number fits in and the slack goes to the
                         right-hand label column. -->
                    <Grid RowDefinitions="76,32,32,32,32,32,32,Auto"
                          ColumnDefinitions="90,96,*,96,46">

                        <!-- Row number + big symbol | color well + name | visibility. -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,6"
                              ColumnDefinitions="*,*,*">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SortIndex}" FontSize="12" Opacity="0.7"
                                           VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <!-- The unique force-field name, which is the
                                     big symbol of the Cocoa cell and is editable
                                     there for anything but a built-in type. -->
                                <TextBox Text="{Binding TypeName, Mode=TwoWay}"
                                         IsReadOnly="{Binding TypeReadOnly}" FontSize="34"
                                         Width="150" MinWidth="0" MinHeight="0"
                                         Padding="4,0,4,2" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="2">
                                <!-- Tagged so the code-behind can find it in the
                                     routed PointerPressed: a template cannot wire
                                     a Click handler of its own. -->
                                <Border Tag="colorwell" Width="110" Height="38" CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="{Binding Swatch}"/>
                                <TextBlock Text="{Binding ElementName}" FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Atom visibility" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <!-- IsChecked is nullable: null is the '-' glyph.
                                     OneWay + Click write the model, so ItemsView
                                     recycle cannot push null through a TwoWay
                                     setter. FallbackValue / TargetNullValue / the
                                     style setter cover the first paint;
                                     CoerceVisibilityCheckBoxes runs after a card
                                     rebuild (forking a set). -->
                                <CheckBox IsChecked="{Binding Visible, Mode=OneWay, FallbackValue=True, TargetNullValue=True}"
                                          IsEnabled="{Binding IsEditable}" IsThreeState="False"
                                          MinWidth="0"
                                          MinHeight="0" Padding="0" VerticalAlignment="Center"
                                          Click="OnVisibilityClick"
                                          DataContextChanged="OnVisibilityBoxDataContextChanged">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                                            <Setter Property="IsChecked" Value="True"/>
                                            <Setter Property="IsTextScaleFactorEnabled" Value="False"/>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </StackPanel>
                        </Grid>

                        <!-- Number | Atomic mass. -->
                        <TextBlock Grid.Row="1" Text="Number" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding AtomicNumber, Mode=TwoWay}"
                                 IsReadOnly="{Binding TypeReadOnly}" FontSize="12" MinWidth="0"
                                 MinHeight="0" Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Atomic mass" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Mass, Mode=TwoWay}"
                                 IsReadOnly="{Binding TypeReadOnly}" FontSize="12" MinWidth="0"
                                 MinHeight="0" Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="amu" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <!-- Element | Atomic radius. -->
                        <TextBlock Grid.Row="2" Text="Element" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Symbol, Mode=TwoWay}"
                                 IsReadOnly="{Binding TypeReadOnly}" FontSize="12" MinWidth="0"
                                 MinHeight="0" Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Atomic radius" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding AtomicRadius}"
                                 IsReadOnly="True" FontSize="12" MinWidth="0" MinHeight="0"
                                 Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="&#xC5;" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <!-- Group | Covalent radius. -->
                        <TextBlock Grid.Row="3" Text="Group" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GroupText}"
                                 IsReadOnly="True" FontSize="12" MinWidth="0" MinHeight="0"
                                 Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Covalent radius" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding CovalentRadius}"
                                 IsReadOnly="True" FontSize="12" MinWidth="0" MinHeight="0"
                                 Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="&#xC5;" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <!-- Period | Van der Waals radius. -->
                        <TextBlock Grid.Row="4" Text="Period" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PeriodText}"
                                 IsReadOnly="True" FontSize="12" MinWidth="0" MinHeight="0"
                                 Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Van der Waals radius"
                                   FontSize="12" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding VDWRadius}"
                                 IsReadOnly="True" FontSize="12" MinWidth="0" MinHeight="0"
                                 Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="&#xC5;" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <!-- Triple bond covalent radius (merged label, Cocoa row 6). -->
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="3"
                                   Text="Triple bond covalent radius" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding TripleBondRadius}"
                                 IsReadOnly="True" FontSize="12" MinWidth="0" MinHeight="0"
                                 Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="4" Text="&#xC5;" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <!-- User-defined radius (merged label, Cocoa row 7). -->
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="User-defined radius"
                                   FontSize="12" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="6" Grid.Column="3"
                                 Text="{Binding UserRadius, Mode=TwoWay}"
                                 IsReadOnly="{Binding ReadOnly}" FontSize="12" MinWidth="0"
                                 MinHeight="0" Padding="4,2,4,3" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="6" Grid.Column="4" Text="&#xC5;" FontSize="12"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <!-- Oxidation states + epsilon + sigma. -->
                        <Grid Grid.Row="7" Grid.ColumnSpan="5" Margin="0,8,0,0"
                              ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Possible oxidation states" FontSize="11"
                                           Opacity="0.8"/>
                                <TextBox Text="{Binding Oxidation}" IsReadOnly="True" FontSize="12"
                                         MinWidth="0" MinHeight="0" Padding="4,2,4,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Bottom" Margin="0,0,12,0">
                                <TextBlock Text="Epsilon" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Epsilon, Mode=TwoWay}"
                                         IsReadOnly="{Binding ReadOnly}" Width="78" FontSize="12"
                                         MinWidth="0" MinHeight="0" Padding="4,2,4,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Bottom">
                                <TextBlock Text="Sigma" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Sigma, Mode=TwoWay}"
                                         IsReadOnly="{Binding ReadOnly}" Width="78" FontSize="12"
                                         MinWidth="0" MinHeight="0" Padding="4,2,4,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" Padding="12,12,12,0">
            <TextBlock x:Name="NoDocumentHint" Text="No document loaded."
                       Opacity="0.7" Visibility="Collapsed"/>
            <ItemsView x:Name="List" SelectionMode="Single"
                       ItemTemplate="{StaticResource ElementCardTemplate}"
                       SelectionChanged="OnSelectionChanged"
                       RightTapped="OnListRightTapped"/>
        </Grid>

        <Grid x:Name="BottomBar" Grid.Row="1" Padding="12,6,12,8"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,*">
            <!-- Cocoa's [+] / [-] above the table: they add a copy of the
                 selected type, and delete the selected one. -->
            <Button x:Name="AddTypeButton" Content="+" Width="30" MinWidth="0" Padding="0"
                    ToolTipService.ToolTip="Insert a copy of the selected type"
                    Click="OnAddTypeClick"/>
            <Button x:Name="RemoveTypeButton" Grid.Column="1" Content="&#x2212;" Width="30"
                    MinWidth="0" Padding="0" Margin="4,0,10,0"
                    ToolTipService.ToolTip="Delete the selected type"
                    Click="OnRemoveTypeClick"/>
            <TextBlock Grid.Column="2" Text="Force field" VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <!-- Editable, as the Cocoa NSComboBoxes are: a name that is not in
                 the list forks the set now shown under that name. -->
            <ComboBox x:Name="ForceFieldCombo" Grid.Column="3" HorizontalAlignment="Stretch"
                      IsEditable="True"
                      ToolTipService.ToolTip="Pick a force field set, or type a name to copy the current one into a new, editable set."
                      SelectionChanged="OnForceFieldSetChanged"
                      TextSubmitted="OnForceFieldSetSubmitted"/>
            <TextBlock Grid.Column="4" Text="Color" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <ComboBox x:Name="ColorCombo" Grid.Column="5" HorizontalAlignment="Stretch"
                      IsEditable="True"
                      ToolTipService.ToolTip="Pick a color set, or type a name to copy the current one into a new, editable set."
                      SelectionChanged="OnColorSetChanged"
                      TextSubmitted="OnColorSetSubmitted"/>
        </Grid>
    </Grid>
</UserControl>
