  <!-- The XAML compiler derives App from ApplicationT, which drops the App_base
       specialisation that App.xaml.h relies on. Patch the generated header back. -->
  <Target Name="FixAppXamlBase" AfterTargets="MarkupCompilePass1;MarkupCompilePass2;XamlPreCompile">
    <PropertyGroup>
      <_AppXamlG>$(GeneratedFilesDir)App.xaml.g.h</_AppXamlG>
    </PropertyGroup>
    <Exec Condition="Exists('$(_AppXamlG)')" Command="powershell -NoProfile -Command &quot;(Get-Content -Raw '$(_AppXamlG)') -replace 'struct AppT:\s*public ::winrt::Microsoft::UI::Xaml::ApplicationT&lt;D, ::winrt::Microsoft::UI::Xaml::Markup::IXamlMetadataProvider, Interfaces\.\.\.&gt;','struct AppT: public App_base&lt;D, ::winrt::Microsoft::UI::Xaml::Markup::IXamlMetadataProvider, Interfaces...&gt;' | Set-Content -NoNewline '$(_AppXamlG)'&quot;" />
  </Target>

  <!-- Win32 codegen emits empty .xbf placeholders that suppress .xaml in the PRI.
       Deploy .xaml next to the exe and refresh iRASPA.pri for unpackaged LoadComponent. -->
  <Target Name="DeployUnpackagedXaml" AfterTargets="Build">
    <PropertyGroup>
      <_GenDir>$([System.IO.Path]::GetFullPath('$(GeneratedFilesDir)').TrimEnd('\'))</_GenDir>
      <_OutDirTrimmed>$([System.IO.Path]::GetFullPath('$(OutDir)').TrimEnd('\'))</_OutDirTrimmed>
      <_DeployScript>$(MSBuildProjectDirectory)\deploy_unpackaged_xaml.ps1</_DeployScript>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_DeployScript)&quot; -OutDir &quot;$(_OutDirTrimmed)&quot; -GenDir &quot;$(_GenDir)&quot;" />
  </Target>

  <!-- Application icon (same artwork as the Cocoa app icon) for the About panel. -->
  <Target Name="DeployAppIcon" AfterTargets="Build">
    <PropertyGroup>
      <_OutDirTrimmed>$([System.IO.Path]::GetFullPath('$(OutDir)').TrimEnd('\'))</_OutDirTrimmed>
      <_AppIconSrc>$(IraspaRoot)\datafiles\iraspa.iconset\icon_512x512.png</_AppIconSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_AppIconSrc)" DestinationFiles="$(_OutDirTrimmed)\Assets\AppIcon.png" SkipUnchangedFiles="true" Condition="Exists('$(_AppIconSrc)')" />
  </Target>

  <!-- Gallery examples and the CoRE MOF / IZA databases next to the exe for startup load. -->
  <Target Name="DeployGalleryDatabase" AfterTargets="Build">
    <PropertyGroup>
      <_OutDirTrimmed>$([System.IO.Path]::GetFullPath('$(OutDir)').TrimEnd('\'))</_OutDirTrimmed>
    </PropertyGroup>
    <ItemGroup>
      <_StructureDatabase Include="$(IraspaRoot)\datafiles\libraryofstructures.irspdoc" />
      <_StructureDatabase Include="$(IraspaRoot)\datafiles\databasecoremof.irspdoc" />
      <_StructureDatabase Include="$(IraspaRoot)\datafiles\databasecoremofddec.irspdoc" />
      <_StructureDatabase Include="$(IraspaRoot)\datafiles\databaseiza.irspdoc" />
    </ItemGroup>
    <Copy SourceFiles="@(_StructureDatabase)" DestinationFolder="$(_OutDirTrimmed)" SkipUnchangedFiles="true" Condition="Exists('%(_StructureDatabase.FullPath)')" />
  </Target>

  <!-- Cocoa bundles AcknowledgedLicenses.pdf; About opens it from next to the exe. -->
  <Target Name="DeployAcknowledgedLicenses" AfterTargets="Build">
    <PropertyGroup>
      <_OutDirTrimmed>$([System.IO.Path]::GetFullPath('$(OutDir)').TrimEnd('\'))</_OutDirTrimmed>
      <_LicensesSrc>$(IraspaRoot)\datafiles\acknowledgedlicenses.pdf</_LicensesSrc>
    </PropertyGroup>
    <Copy SourceFiles="$(_LicensesSrc)"
          DestinationFiles="$(_OutDirTrimmed)\AcknowledgedLicenses.pdf"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_LicensesSrc)')" />
    <Warning Condition="!Exists('$(_LicensesSrc)')"
             Text="acknowledgedlicenses.pdf not found at $(_LicensesSrc); About Acknowledgements will not open a PDF." />
  </Target>

  <!-- The Shader Model 6 compiler, needed by the ray-tracing kernels: FXC stops at Shader
       Model 5.1 and cannot compile a RayQuery. The SDK ships the DLLs but no import library,
       so DirectXDxcCompiler loads them by name and they have to sit next to the exe. dxil.dll
       signs the DXIL that dxcompiler.dll emits; without it the D3D12 runtime rejects the
       shader on a machine that is not in developer mode. -->
  <Target Name="DeployShaderCompiler" AfterTargets="Build">
    <PropertyGroup>
      <_ShaderCompilerDir>$(WindowsSdkDir)bin\$(TargetPlatformVersion)\$(PlatformTarget)</_ShaderCompilerDir>
    </PropertyGroup>
    <ItemGroup>
      <_ShaderCompilerFiles Include="$(_ShaderCompilerDir)\dxcompiler.dll" Condition="Exists('$(_ShaderCompilerDir)\dxcompiler.dll')" />
      <_ShaderCompilerFiles Include="$(_ShaderCompilerDir)\dxil.dll" Condition="Exists('$(_ShaderCompilerDir)\dxil.dll')" />
    </ItemGroup>
    <Warning Condition="'@(_ShaderCompilerFiles)' == ''"
             Text="dxcompiler.dll and dxil.dll not found in $(_ShaderCompilerDir); ray tracing will be unavailable and the renderer will rasterize instead." />
    <Copy SourceFiles="@(_ShaderCompilerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The redistributable Direct3D 12 runtime and software adapter, in a D3D12\ subfolder because
       that is the path directxagilitysdk.h exports. Without them a machine whose card cannot trace
       silently traces nothing at all rather than falling back; external\d3d12\README.md has the
       detail. Not a warning-only step in spirit, but a missing runtime only costs traced exports on
       such machines, so a build without these files is still worth having. -->
  <Target Name="DeployDirect3DRuntime" AfterTargets="Build">
    <PropertyGroup>
      <_Direct3DRuntimeDir>$(MSBuildThisFileDirectory)..\external\d3d12\$(PlatformTarget)</_Direct3DRuntimeDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- The runtime goes in the subfolder directxagilitysdk.h names, the adapter next to the exe.
           The two are not interchangeable: D3D12Core.dll is found through the exported path, while
           d3d10warp.dll is found the ordinary way, so a WARP placed in the subfolder is not loaded
           at all and the fallback quietly rasterizes instead of tracing. -->
      <_Direct3DRuntimeFiles Include="$(_Direct3DRuntimeDir)\D3D12Core.dll" Condition="Exists('$(_Direct3DRuntimeDir)\D3D12Core.dll')" />
      <!-- The validating runtime, which only a Debug build asks for. -->
      <_Direct3DRuntimeFiles Include="$(_Direct3DRuntimeDir)\d3d12SDKLayers.dll" Condition="'$(Configuration)' == 'Debug' and Exists('$(_Direct3DRuntimeDir)\d3d12SDKLayers.dll')" />
      <_Direct3DAdapterFiles Include="$(_Direct3DRuntimeDir)\d3d10warp.dll" Condition="Exists('$(_Direct3DRuntimeDir)\d3d10warp.dll')" />
    </ItemGroup>
    <Warning Condition="'@(_Direct3DRuntimeFiles)' == '' or '@(_Direct3DAdapterFiles)' == ''"
             Text="Incomplete redistributable D3D12 runtime in $(_Direct3DRuntimeDir); on a machine without DXR 1.1 a traced export will fall back to rasterizing." />
    <Copy SourceFiles="@(_Direct3DRuntimeFiles)" DestinationFolder="$(OutDir)D3D12" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_Direct3DAdapterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Embeddable CPython for the console, in a Python\ subfolder rather than beside
       the exe: the distribution carries its own vcruntime140*.dll copies, which would
       otherwise sit next to the app's own CRT and confuse both the packager and
       anyone reading the output directory. -->
  <Target Name="DeployPythonRuntime" AfterTargets="Build">
    <ItemGroup>
      <_PythonRuntimeFiles Include="$(PythonRuntimeDir)\**\*" />
    </ItemGroup>
    <Warning Condition="'@(_PythonRuntimeFiles)' == ''"
             Text="No embeddable Python runtime found in $(PythonRuntimeDir); the console will report Python as unavailable." />
    <Copy SourceFiles="@(_PythonRuntimeFiles)"
          DestinationFiles="@(_PythonRuntimeFiles->'$(OutDir)Python\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
