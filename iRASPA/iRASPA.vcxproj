  <PropertyGroup>
    <!-- Embedded Python for the console. Two separate things, which must stay on the
         same version: the SDK (headers plus import library) comes from the official
         python NuGet packages and is build-time only, while the interpreter that
         actually ships is the embeddable runtime committed under PythonRunTimes\.
         python$(PythonAbi).dll is delay-loaded and PythonConsole.cpp loads it from
         the app-local Python\ folder, so nothing needs to be installed on the
         machine running iRASPA. -->
    <PythonVersion Condition="'$(PythonVersion)' == ''">3.14.7</PythonVersion>
    <PythonAbi Condition="'$(PythonAbi)' == ''">314</PythonAbi>
    <PythonSdkDir Condition="'$(PythonSdkDir)' == '' and '$(Platform)' == 'x64'">$(MSBuildThisFileDirectory)..\packages\python.$(PythonVersion)\tools</PythonSdkDir>
    <PythonSdkDir Condition="'$(PythonSdkDir)' == '' and '$(Platform)' == 'ARM64'">$(MSBuildThisFileDirectory)..\packages\pythonarm64.$(PythonVersion)\tools</PythonSdkDir>
    <PythonRuntimeDir Condition="'$(PythonRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\PythonRunTimes\$(Platform)</PythonRuntimeDir>
    <!-- Output is per-platform: x64 and ARM64 builds would otherwise overwrite
         each other's exe and Windows App SDK payload. -->
    <OutDir>$(MSBuildThisFileDirectory)..\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\obj\$(Platform)\$(Configuration)\</IntDir>
    <!-- Per configuration, overriding Microsoft.Cpp.AppContainerApplication.props, which puts
         it in the project directory. The C++/WinRT projections and the XAML codegen land here,
         but the stamp files that mark them up to date (obj\...\*.cppwinrt_*.rsp) are always per
         configuration: with one shared directory, cleaning or rebuilding one platform deletes
         the projection the others still believe they generated, and the next build of those
         fails on a missing winrt\Windows.Foundation.h. -->
    <GeneratedFilesDir>$(IntDir)Generated Files\</GeneratedFilesDir>
  </PropertyGroup>
